# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=queueless
DB_PORT=5432

# --- Backend --------------------------------------------------------------
# Must be at least 32 characters; the API refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
BACKEND_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000/api
# The backend now implements /api/queues and /api/tickets. Set this to false to
# use the real API instead of the in-browser mock in frontend/src/services.
VITE_USE_MOCK_API=false

# --- Production override --------------------------------------------------
# docker-compose.prod.yml reads these; it fails fast if they are unset.
# FRONTEND_PORT=8080
# CLIENT_ORIGIN=http://localhost:8080