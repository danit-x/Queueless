# --- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=queueless
DB_PORT=5432

# --- Backend --------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
BACKEND_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Frontend -------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000/api
# Set to false once the backend implements the /queues and /tickets endpoints
VITE_USE_MOCK_API=true

# --- Production override --------------------------------------------------
# docker-compose.prod.yml reads these; it fails fast if they are unset.
# FRONTEND_PORT=8080
# CLIENT_ORIGIN=http://localhost:8080