# --- Required --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/queueless
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Optional --------------------------------------------------------------
# NODE_ENV is set by the Dockerfile/compose file, not here, so it is never
# silently overridden.
# PostgreSQL TLS: off | require | verify-full. Use `require` or `verify-full`
# for managed hosts (RDS, Neon, Supabase); leave off for a local container.
# DATABASE_SSL=off
# Maximum pooled connections. Raise it if PostgreSQL max_connections allows.
# DB_POOL_MAX=10
# Access token lifetime.
# JWT_EXPIRES_IN=1h
# bcrypt cost factor. Lower it in CI to keep tests fast.
# BCRYPT_ROUNDS=12
# Set to true when running behind nginx or a load balancer so client IPs and
# rate limiting see the real address instead of the proxy.
# TRUST_PROXY=false
# Apply database/schema.sql on startup (idempotent). Set to false to verify the
# schema without writing to it.
# AUTO_MIGRATE=true
# Explicit path to schema.sql. Only needed when it cannot be auto-detected.
# SCHEMA_PATH=/app/database/schema.sql