FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache wget

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:${PORT:-5000}/api/health || exit 1

CMD ["npm", "run", "dev"]